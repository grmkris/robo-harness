{
  "name": "robo-harness",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "python"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "start": "bun apps/server/src/main.ts",
    "build": "bun --filter @robo/web build",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "test": "bun test apps packages",
    "check:fast": "bun run format:check && bun run lint && bun run typecheck && bun run graph",
    "check": "bun run check:fast && bun run lint:types && bun run knip && bun run test",
    "lint": "oxlint .",
    "lint:types": "oxlint --type-aware --report-unused-disable-directives .",
    "cli": "bun apps/cli/src/main.ts",
    "mcp": "bun apps/cli/src/mcp.ts",
    "graph": "bun tools/check-graph.ts",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@oxlint/plugins": "1.81.0",
    "@types/bun": "1.4.1",
    "knip": "6.34.0",
    "lefthook": "2.1.12",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "ultracite": "7.10.8"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.2"
}
