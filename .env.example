# Copy to .env. Tokens are generated privately in var/ when omitted.
# Tailnet mode opens the workbench without a login; token mode is optional.
ROBO_ACCESS_MODE=tailnet
ROBO_HOST=127.0.0.1
ROBO_PORT=8940
# Sqlite, generated tokens, recordings and workspaces. Keep it outside any git checkout.
# ROBO_DATA_DIR=/home/kristjan/.local/state/robo-harness
ROBO_IO_URL=http://127.0.0.1:8941
# Extra browser origins allowed to issue commands (the bind address is always allowed).
# ROBO_ALLOWED_ORIGINS=http://127.0.0.1:5178
# Tailnet mode trusts Tailscale peers by address. Loopback peers are trusted only when
# the server is bound to loopback; set 1 or 0 to override.
# ROBO_TRUST_LOOPBACK=
# For the reviewed Pi deployment: http://<pi-tailnet-ip>:8941
# ROBO_IO_TOKEN must match the Pi service's private environment file.
# The Pi service binds ROBO_IO_HOST (its own tailnet address); set it in the Pi's io.env.
# ROBO_TOKEN=
# ROBO_AGENT_TOKEN=
# ROBO_WORKER_TOKEN=

# Direct model providers. Existing account files are never imported implicitly.
# DASHSCOPE_API_KEY=  (or ALIBABA_TOKEN_PLAN_API_KEY, as stored in ~/.config/secrets.env)
ROBO_ALIBABA_MODEL=qwen3.8-max
# Extra models the chat picker offers for this provider (comma-separated); the
# default above is always first. Only list models the account can actually serve.
# ROBO_ALIBABA_MODELS=qwen3.8-max,qwen-plus
# Documented model image support is detected on official endpoints.
# Explicit 0 disables images; 1 enables only the default model.
# ROBO_ALIBABA_VISION=0
# ROBO_ALIBABA_VISION_MODELS=qwen3.8-max
# XAI_API_KEY=
# ROBO_XAI_AUTH_FILE=/home/kristjan/.grok/auth.json
ROBO_XAI_MODEL=grok-4.6
# ROBO_XAI_MODELS=grok-4.6,grok-4
# ROBO_XAI_VISION_MODELS=grok-4.6

# Decision runs (bun run jev): TypeSafe Jev through Vercel AI Gateway. Needs paid Gateway credits.
# AI_GATEWAY_API_KEY=
# ROBO_JEV_BUDGET_USD=10
# Zero data retention is refused on Hobby plans; opt in with 1 on Pro/Enterprise.
# ROBO_JEV_ZDR=1
# Pickup scene describer: any OpenAI-compatible chat endpoint (cliproxy on netcup by default).
# CLIPROXY_API_KEY=
# ROBO_SCENE_URL=http://127.0.0.1:8317/v1/chat/completions
# ROBO_SCENE_API_KEY=
# ROBO_SCENE_MODEL=gemini-3.8-flash

# Perception: private worker, catalog fal adapters, or a custom compatible endpoint.
# ROBO_PERCEPTION_URL=http://your-private-gpu-worker:8790
# ROBO_PERCEPTION_TOKEN=
# ROBO_FAL_SEGMENT_ENDPOINT=fal-ai/sam-3/image
# ROBO_FAL_DEPTH_ENDPOINT=fal-ai/image-preprocessors/depth-anything/v2
# ROBO_FAL_ENDPOINT=your-account/robo-perception
# FAL_KEY=
# Conservative maximum charge per request; approve the aggregate cap in Activity.
ROBO_PERCEPTION_COST_USD=0
# DA3_CHECKPOINT and SAM3_CHECKPOINT belong on the GPU worker, not the Pi.

ROBO_DEV_IMAGE=robo-harness-dev:local
# Containers run on Docker's bridge network; host is a development-only escape hatch.
# ROBO_SHELL_NETWORK=bridge
# Dedicated account, without sudo, production secrets, or dialout/video groups:
# ROBO_PI_DEV_HOST=robo-dev@lab-pi

# URL reachable from the dedicated Pi development account:
# ROBO_PI_PROGRAM_URL=http://<app-tailnet-ip>:8940
# Optional override for Netcup development containers:
# ROBO_PROGRAM_URL=http://<app-tailnet-ip>:8940

# Optional isolated CPU Python with LeRobot dataset dependencies.
# ROBO_EXPORT_PYTHON=/absolute/path/to/export-venv/bin/python
