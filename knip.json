{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/*.mjs",
        "tools/check-graph.ts",
        "tools/oxlint/*.ts"
      ],
      "project": ["scripts/**/*.{ts,mjs}", "tools/**/*.ts"]
    },
    "apps/server": { "entry": ["src/main.ts", "test/*.test.ts"] },
    "apps/cli": { "entry": ["src/main.ts", "src/mcp.ts"] },
    "apps/web": {},
    "packages/domain": {},
    "packages/protocol": { "entry": ["src/index.ts", "test/*.test.ts"] },
    "python": {}
  }
}
