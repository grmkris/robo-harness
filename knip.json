{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@oxlint/plugins"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "scripts/*.mjs"],
      "project": "scripts/**/*.{ts,mjs}"
    },
    "apps/server": { "entry": ["src/main.ts", "test/*.test.ts"] },
    "apps/cli": { "entry": ["src/main.ts", "src/mcp.ts"] },
    "apps/web": {},
    "packages/domain": {},
    "packages/protocol": { "entry": ["src/index.ts", "test/*.test.ts"] }
  }
}
