[Unit]
Description=Robo Harness LeRobot motor owner
After=network-online.target
Wants=network-online.target
Conflicts=labcam-preview.service

[Service]
Type=simple
User=robo-io
SupplementaryGroups=dialout video
WorkingDirectory=/opt/robo-harness/current
EnvironmentFile=/etc/robo-harness/io.env
ExecStart=/opt/robo-harness/venv/bin/robo-io --profile /etc/robo-harness/robot.json --host 100.77.154.45 --port 8941
Restart=no
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/lock /tmp /var/lib/robo-harness
PrivateTmp=no
UMask=0077

[Install]
WantedBy=multi-user.target
