[Unit]
Description=Robo Harness Rerun telemetry worker
After=robo-app.service
Requires=robo-app.service

[Service]
Type=simple
WorkingDirectory=/home/kristjan/code/robo-harness
EnvironmentFile=/home/kristjan/.config/robo-harness.env
ExecStart=/home/kristjan/code/robo-harness/.venv/bin/robo-rerun
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
