[Unit]
Description=Robo Harness workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The deploy worktree is a checkout of the tagged release, never the working tree
# where development happens; see docs/real-arm-preflight.md "Deployment".
WorkingDirectory=/home/kristjan/code/robo-harness-deploy
EnvironmentFile=/home/kristjan/code/robo-harness-deploy/.env
ExecStart=/home/kristjan/.bun/bin/bun src/server/main.ts
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
