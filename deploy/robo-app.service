[Unit]
Description=Robo Harness workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs from the main working tree; no deploy worktree. Real config and the
# provider credentials live in the external env file, so the repo .env stays
# dev/mock. Data lives outside the repo via ROBO_DATA_DIR.
WorkingDirectory=/home/kristjan/code/robo-harness
EnvironmentFile=/home/kristjan/.config/robo-harness.env
ExecStart=/home/kristjan/.bun/bin/bun apps/server/src/main.ts
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=default.target
